@page "/"
@rendermode InteractiveServer

<main>
    <h1>routes</h1>
    <div class="routes">
        <div class="route-builder">
            <EditForm Model="routeForm" OnSubmit="RouteSubmit" FormName="RouteForm">
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    Write a waypoint:
                    <InputText style="background-color: rgb(45, 45, 45); color: rgb(245, 245, 245);" 
                        @bind-Value="routeForm!.Waypoint"
                        @onkeydown="RouteFormKeyPress"/>
                </div>
            </EditForm>
            <div class="current-route-list">
                @for (int index = 0; index < currentRoute.Count; index++)
                    {
                    var i = index;
                    <div class="waypoint-row">
                        <div class="action-left">
                            @if (i != 0)
                            {
                            <a @onclick="() => MoveWaypointUp(i)">↑</a>
                            }
                        </div>

                        <span class="waypoint-text">@currentRoute[i]</span>

                        <div class="action-right">
                            <a class="delete-btn" @onclick="() => currentRoute.RemoveAt(i)">x</a>
                            @if (i != currentRoute.Count - 1)
                            {
                            <a @onclick="() => MoveWaypointDown(i)">↓</a>
                            }
                        </div>
                    </div>
                    }
                    <button class="create-btn" @onclick="CreateRoute">Create</button>
            </div>
        </div>
        <div class="route-display">
            @foreach (KeyValuePair<int , List<string>> kvp in routes)
                {
                <details>
                    <summary>@($"Route #{kvp.Key}")</summary>
                </details>
                <div class="details-content">
                    <p>@(string.Join(" -> ", kvp.Value))</p>
                </div>
                }
        </div>
    </div>

    <h1>trains</h1>
    <div class="trains">
        <div class="train-display">
            @foreach (KeyValuePair<int , List<string>> kvp in routes)
                {
                <details>
                    <summary>@("")</summary>
                </details>
                <div class="details-content">
                    <p>@(string.Join(" -> ", kvp.Value))</p>
                </div>
                }
        </div>
    </div>
</main>
